# cage.env.example: every setting the cage reads, in one file.
#
# Copy it to cage.env next to compose.yaml, fill in every value that starts with "your-",
# and keep cage.env root-owned (chmod 600). apply.sh refuses to run while a "your-" value is
# left. cage.env is gitignored: it describes your machine, so it never ships.
#
# The file is read two ways, so keep it plain: compose reads it for ${...} interpolation
# (docker compose --env-file cage.env), and the host scripts source it. Quote any value with a
# space, and never put a $ in a value.
#
# No secret goes in this file. The agent's token lives in TOKEN_HOST_FILE (see below).

# --- The agent: any image, any command. The cage does not care what runs inside it. ---
# The image must run as an arbitrary uid on a read-only root filesystem. It may write only
# to AGENT_HOME_DIR (mounted at /home/agent), AGENT_OUTBOX_DIR (mounted at /outbox) and /tmp.
AGENT_IMAGE=your-agent-image:1.0
# Run by entrypoint.sh after it has loaded the token. Split on spaces, like a shell would.
AGENT_COMMAND="your-agent run"
# The host user "agent" is created with these ids, and the container runs as them, so the
# mounted folders keep one owner on both sides of the mount. Never 0.
AGENT_UID=10001
AGENT_GID=10001
# Host folders the agent may write. Owned by AGENT_UID. Everything else is read-only or absent.
AGENT_HOME_DIR=/home/agent
AGENT_OUTBOX_DIR=/home/agent-outbox
# Hard limit on the container's memory (Docker size syntax: 512m, 2g).
AGENT_MEM_LIMIT=4g

# --- The token: a file, never an environment entry. ---
# On the host: owner root, group AGENT_GID, mode 0640, lines of NAME=value.
TOKEN_HOST_FILE=/etc/agent-cage/token
# Where the file appears inside the container (read-only). Leave it unless you have a reason.
CAGE_TOKEN_FILE=/run/cage/token
# Space-separated names entrypoint.sh copies from the file into the agent's own process.
# Leave it empty if the agent needs no token.
CAGE_TOKEN_KEYS="AGENT_TOKEN"

# --- The cage network: a dedicated Docker bridge with a fixed subnet. ---
# Fixed on purpose: the firewall rules and the proxy name it literally, so a floating subnet
# would silently unhook the cage on the next compose down and up. Pick a /24 no other network
# on the host uses.
CAGE_SUBNET=your-cage-subnet
# The bridge's gateway address, the first host address of CAGE_SUBNET. From inside the
# container this address is the host, where the egress proxy listens.
CAGE_GATEWAY=your-cage-gateway
# Linux name of the bridge, shown in ip link and iptables counters.
CAGE_BRIDGE=br-agent-cage

# --- The one door to the web: an allowlisting proxy on the host. ---
# tinyproxy listens on this port; only CAGE_SUBNET may use it, and only for the hostnames in
# PROXY_ALLOWLIST. The shipped list allows one chat API host. Read THREAT-MODEL.md before you
# add any: the proxy resolves each name and connects from the host.
PROXY_PORT=3128
PROXY_ALLOWLIST=host/proxy-allowlist.messenger

# --- The one door into the tailnet (optional). ---
# One host and one TCP port on your tailnet the agent may reach, such as a model server.
# Leave TAILNET_ALLOW_HOST empty and the cage reaches nothing on the tailnet at all.
TAILNET_ALLOW_HOST=your-model-host
TAILNET_ALLOW_PORT=8000
# The tailnet's network interface on the host.
TAILNET_IFACE=tailscale0

# --- verify-cage.sh: the fire drills. ---
# A URL the cage must NOT reach directly. Any outside host works; the drill only connects.
VERIFY_EGRESS_URL=http://example.com/
# A tailnet address and port the cage must NOT reach. Use a real machine on your tailnet with
# an open port that is not TAILNET_ALLOW_HOST:TAILNET_ALLOW_PORT, or the drill proves little.
VERIFY_TAILNET_HOST=your-other-tailnet-host
VERIFY_TAILNET_PORT=22
# Names that must hold no value in the container's environment. Usually CAGE_TOKEN_KEYS.
VERIFY_TOKEN_VARS="AGENT_TOKEN"

# --- Advanced: leave these unless your host differs. ---
# Where ufw keeps the rules it loads after its own; egress-rules.sh persists the cage there.
UFW_AFTER_RULES=/etc/ufw/after.rules
