#!/usr/bin/env bash
# A stand-in for iptables in the tests. It keeps each chain as a file of "-A CHAIN ..." lines
# under $STUB_STATE and supports only what the cage scripts call: -N, -S, -A, -I N, -D.
# Every call is logged to $STUB_STATE/calls.
set -u
st="${STUB_STATE:?}"
echo "iptables $*" >>"$st/calls"
op="${1:-}"; chain="${2:-}"
shift 2 || exit 2
f="$st/chain.$chain"
case "$op" in
  -N) [ -f "$f" ] && exit 1; : >"$f" ;;
  -S)
    [ -f "$f" ] || exit 1
    if [ "$chain" = FORWARD ]; then echo "-P FORWARD DROP"; else echo "-N $chain"; fi
    cat "$f"
    ;;
  -A) [ -f "$f" ] || : >"$f"; echo "-A $chain $*" >>"$f" ;;
  -I)
    n="$1"; shift
    [ -f "$f" ] || : >"$f"
    awk -v n="$n" -v l="-A $chain $*" 'NR == n { print l; done = 1 } { print } END { if (!done) print l }' \
      "$f" >"$f.t" && mv "$f.t" "$f"
    ;;
  -D)
    line="-A $chain $*"
    [ -f "$f" ] && grep -qxF -- "$line" "$f" || exit 1
    awk -v l="$line" '!d && $0 == l { d = 1; next } { print }' "$f" >"$f.t" && mv "$f.t" "$f"
    ;;
  *) exit 2 ;;
esac
